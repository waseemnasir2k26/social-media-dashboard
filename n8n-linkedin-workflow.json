{
  "name": "SkynetJoe LinkedIn Poster",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "linkedin-post",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "wh-001",
      "name": "Receive Post",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 340],
      "webhookId": "skynetjoe-linkedin"
    },
    {
      "parameters": {
        "jsCode": "const item = $input.first();\n\n// Extract text fields from webhook body\nconst body = item.json.body || item.json;\nconst caption = body.caption || '';\nconst scheduledDate = body.scheduledDate || '';\n\n// Determine if this is a scheduled post\nconst now = new Date();\nconst scheduleTime = scheduledDate ? new Date(scheduledDate) : null;\nconst hasSchedule = !!(scheduleTime && scheduleTime > now);\n\n// Normalize binary property name to 'image' for downstream nodes\nconst binary = {};\nconst keys = Object.keys(item.binary || {});\nif (keys.length > 0) {\n  binary.image = item.binary[keys[0]];\n}\n\nreturn [{\n  json: {\n    caption,\n    scheduledDate: scheduledDate || null,\n    hasSchedule,\n    timestamp: now.toISOString()\n  },\n  binary\n}];"
      },
      "id": "code-001",
      "name": "Normalize Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [460, 340]
    },
    {
      "parameters": {
        "name": "={{ 'linkedin_' + $now.format('yyyy-MM-dd_HHmmss') + '.jpg' }}",
        "options": {}
      },
      "id": "gdrive-001",
      "name": "Archive to Drive",
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [680, 540],
      "credentials": {
        "googleDriveOAuth2Api": {
          "id": "",
          "name": ""
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json.hasSchedule }}",
